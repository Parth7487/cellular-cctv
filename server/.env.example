# Server Listening Port
PORT=8080

# Room Security Token (Optional: leave empty to allow open room joining during development)
ROOM_TOKEN_SECRET=dev-secret-cctv

# STUN Servers (Comma-separated list)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN Relay Configuration (Required for strict Cellular 4G/5G CGNAT Traversal)
# Free Metered.ca TURN or Coturn instance:
# TURN_URL=turn:openrelay.metered.ca:80
# TURN_USERNAME=openrelayproject
# TURN_CREDENTIAL=openrelayproject
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
